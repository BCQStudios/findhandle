---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<main>
			<p class="kicker">Not found</p>
			<h1>This page is not here</h1>
			<p class="lede"><a href="https://www.findhandle.com">Back to FindHandle</a></p>
		</main>
	</div>
</Layout>

<style>
	.page {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 24px;
	}

	main {
		text-align: center;
	}

	.lede {
		margin: 12px 0 0;
		font-size: 15px;
	}

	.lede a {
		color: var(--fg);
	}
</style>
