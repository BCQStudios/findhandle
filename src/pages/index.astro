---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<header class="top">
			<a class="brand" href="/">
				<span class="mark" aria-hidden="true"></span>
				FindHandle
			</a>
		</header>

		<main>
			<p class="kicker">Handle check</p>
			<h1>See if a name is free</h1>
			<p class="lede">Matching handles. A brand you can hold.</p>

			<form id="search" autocomplete="off" spellcheck="false">
				<label class="bar">
					<span class="at" aria-hidden="true">@</span>
					<input
						id="handle"
						name="handle"
						type="text"
						inputmode="text"
						autocapitalize="none"
						autocorrect="off"
						maxlength="30"
						placeholder="yourhandle"
						aria-label="Social handle"
					/>
					<button type="submit">Check</button>
				</label>
			</form>

			<p class="row-label">Social</p>
			<section class="results" aria-live="polite">
				<article class="card" data-check data-platform="youtube" data-status="idle" style="--platform: var(--youtube)">
					<div class="card-head">
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="3.5" fill="currentColor"></rect><path d="M10.2 9.15 15.4 12l-5.2 2.85z" fill="#070708"></path></svg>
						</span>
						<h2>YouTube</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">View</a>
				</article>

				<article class="card" data-check data-platform="tiktok" data-status="idle" style="--platform: var(--tiktok)">
					<div class="card-head">
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<g transform="translate(2.2 2.2) scale(.816)">
									<path fill="#25f4ee" transform="translate(-1.15 0)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
									<path fill="#fe2c55" transform="translate(1.15 0)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
									<path fill="#fff" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"></path>
								</g>
							</svg>
						</span>
						<h2>TikTok</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">View</a>
				</article>

				<article class="card" data-check data-platform="x" data-status="idle" style="--platform: var(--x)">
					<div class="card-head">
						<span class="icon x" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path transform="translate(2.2 2.2) scale(.816)" d="M14.7 10.3L22 2h-2.2l-6.1 6.9L8.7 2H2l7.8 11.1L2 22h2.2l6.8-7.7L15.3 22H22l-7.3-11.7zM11.8 13l-.8-1.1L4.9 3.5h2.7l5.1 7.2.8 1.1 6.7 9.5h-2.7L11.8 13z" fill="currentColor"></path></svg>
						</span>
						<h2>X (twitter)</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">View</a>
				</article>

				<article class="card" data-check data-platform="facebook" data-status="idle" style="--platform: var(--facebook)">
					<div class="card-head">
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="currentColor"></circle><path d="M13.35 19.2v-6.15h2.08l.31-2.4h-2.39V8.9c0-.7.2-1.18 1.2-1.18h1.28V5.56c-.22-.03-.97-.1-1.84-.1-1.82 0-3.07 1.11-3.07 3.15v1.76H8.8v2.4h2.12v6.43h2.43z" fill="#070708"></path></svg>
						</span>
						<h2>Facebook</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">View</a>
				</article>

				<article class="card" data-check data-platform="instagram" data-status="idle" style="--platform: var(--instagram)">
					<div class="card-head">
						<span class="icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><rect x="2.5" y="2.5" width="19" height="19" rx="5.2" fill="none" stroke="currentColor" stroke-width="2"></rect><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"></circle><circle cx="17.15" cy="6.85" r="1.15" fill="currentColor"></circle></svg>
						</span>
						<h2>Instagram</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">View</a>
				</article>
			</section>

			<p class="row-label">Domains</p>
			<section class="results" aria-live="polite">
				<article class="card" data-check data-tld="com" data-status="idle" style="--platform: var(--com)">
					<div class="card-head">
						<h2>.com</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
				</article>
				<article class="card" data-check data-tld="net" data-status="idle" style="--platform: var(--net)">
					<div class="card-head">
						<h2>.net</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
				</article>
				<article class="card" data-check data-tld="org" data-status="idle" style="--platform: var(--org)">
					<div class="card-head">
						<h2>.org</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
				</article>
				<article class="card" data-check data-tld="io" data-status="idle" style="--platform: var(--io)">
					<div class="card-head">
						<h2>.io</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
				</article>
				<article class="card" data-check data-tld="ai" data-status="idle" style="--platform: var(--ai)">
					<div class="card-head">
						<h2>.ai</h2>
					</div>
					<p class="state">Waiting</p>
					<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
				</article>
			</section>

			<p id="summary" class="summary" hidden></p>
		</main>

		<footer>
			Public profile and RDAP lookup. Confirm before you claim a name.
			<p class="credit">
				<a href="https://bcqstudios.com" target="_blank" rel="noreferrer">Made with <span class="heart">&lt;3</span> by BCQStudios</a>
			</p>
		</footer>
	</div>
</Layout>

<style>
	.page {
		min-height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
	}

	.top {
		padding: 20px 24px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--fg);
		text-decoration: none;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.mark {
		width: 14px;
		height: 14px;
		border: 2px solid #fff;
		border-radius: 99px;
		box-shadow: 4px 4px 0 0 var(--available);
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		justify-content: safe center;
		padding: 8px 16px 48px;
	}

	.kicker {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(28px, 5vw, 40px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		text-align: center;
	}

	.lede {
		margin: 10px 0 28px;
		color: var(--muted);
		font-size: 15px;
		text-align: center;
	}

	.row-label {
		width: min(920px, 100%);
		margin: 22px 0 8px;
		color: var(--muted);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	#search {
		width: min(560px, 100%);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 58px;
		padding: 6px 6px 6px 16px;
		background: var(--bar);
		color: var(--ink);
		border-radius: 10px;
	}

	.at {
		color: #6b6b73;
		font-size: 22px;
		font-weight: 700;
		line-height: 1;
	}

	#handle {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", Consolas, monospace;
		font-size: 18px;
		letter-spacing: -0.02em;
		outline: none;
	}

	#handle::placeholder {
		color: #8b8b93;
	}

	.bar:focus-within {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}

	button {
		height: 46px;
		min-width: 96px;
		padding: 0 18px;
		border: 0;
		border-radius: 8px;
		background: var(--ink);
		color: var(--bar);
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
	}

	button:hover {
		background: #1d1d22;
	}

	.results {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 10px;
		width: min(920px, 100%);
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 132px;
		padding: 14px;
		overflow: hidden;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 10px;
	}

	.card::before {
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 3px;
		background: var(--platform);
	}

	.card[data-platform='tiktok']::before {
		background: linear-gradient(90deg, var(--tiktok-cyan), var(--tiktok));
	}

	.card[data-status='checking']::after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 36%;
		height: 3px;
		background: #fff;
		animation: sweep 0.9s linear infinite;
	}

	.card[data-status='available'] {
		border-color: color-mix(in srgb, var(--available) 55%, var(--line));
	}

	.card[data-status='taken'] {
		border-color: color-mix(in srgb, var(--taken) 55%, var(--line));
	}

	.card-head {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 22px;
	}

	.icon {
		display: flex;
		flex: 0 0 22px;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		color: var(--platform);
	}

	.icon.x {
		color: var(--x);
	}

	.icon svg {
		display: block;
		width: 22px;
		height: 22px;
	}

	h2 {
		margin: 0;
		font-size: 13px;
		font-weight: 700;
		line-height: 1;
	}

	[data-tld] h2 {
		font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", Consolas, monospace;
		font-size: 16px;
		letter-spacing: -0.02em;
	}

	.state {
		margin: 18px 0 0;
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	.card[data-status='available'] .state {
		color: var(--available);
	}

	.card[data-status='taken'] .state {
		color: var(--taken);
	}

	.card[data-status='unknown'] .state,
	.card[data-status='invalid'] .state {
		color: var(--unknown);
	}

	.link {
		margin-top: auto;
		padding-top: 12px;
		color: var(--fg);
		font-size: 12px;
		font-weight: 700;
		text-decoration: none;
	}

	.link:hover {
		text-decoration: underline;
	}

	.summary {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 13px;
	}

	footer {
		padding: 0 24px 24px;
		color: #6d6d75;
		font-size: 12px;
		text-align: center;
	}

	.credit {
		margin: 8px 0 0;
	}

	.credit a {
		color: inherit;
		text-decoration: none;
	}

	.credit a:hover {
		text-decoration: underline;
	}

	.heart {
		color: var(--taken);
	}

	@keyframes sweep {
		from { transform: translateX(-120%); }
		to { transform: translateX(320%); }
	}

	@media (max-width: 860px) {
		.results {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.top {
			padding: 16px;
		}

		.bar {
			height: 54px;
		}

		.results {
			grid-template-columns: 1fr;
		}

		button {
			padding: 0 14px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card[data-status='checking']::after {
			animation: none;
			width: 100%;
			opacity: 0.45;
		}
	}
</style>

<script>
	const labels = {
		idle: 'Waiting',
		checking: 'Checking',
		available: 'Available',
		taken: 'Taken',
		invalid: 'Invalid',
		unknown: 'Unverified',
	};

	const formNode = document.querySelector('#search');
	const inputNode = document.querySelector('#handle');
	const summaryNode = document.querySelector('#summary');
	if (!(formNode instanceof HTMLFormElement) || !(inputNode instanceof HTMLInputElement) || !(summaryNode instanceof HTMLElement)) {
		throw new Error('Search UI is missing');
	}

	const form = formNode;
	const input = inputNode;
	const summary = summaryNode;
	const cards = document.querySelectorAll('[data-check]');
	let timer = 0;
	let wave = 0;

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		window.clearTimeout(timer);
		void run(clean(input.value));
	});

	input.addEventListener('change', () => {
		window.clearTimeout(timer);
		const handle = clean(input.value);
		if (!handle) reset();
		else void run(handle);
	});

	input.addEventListener('input', () => {
		const next = input.value.replace(/^@+/, '').replace(/[^a-zA-Z0-9._-]/g, '');
		if (next !== input.value) input.value = next;
		window.clearTimeout(timer);
		const handle = clean(next);
		if (!handle) {
			reset();
			return;
		}
		timer = window.setTimeout(() => {
			void run(handle);
		}, 400);
	});

	function clean(value: string) {
		return value.trim().replace(/^@+/, '').toLowerCase();
	}

	function reset() {
		wave += 1;
		for (const card of cards) paint(card, 'idle');
		summary.hidden = true;
		summary.textContent = '';
	}

	async function run(handle: string) {
		if (!handle) {
			reset();
			return;
		}

		const id = ++wave;
		for (const card of cards) paint(card, 'checking');
		summary.hidden = true;

		await Promise.all(
			[...cards].map(async (card) => {
				const platform = card.getAttribute('data-platform');
				const tld = card.getAttribute('data-tld');
				const query = platform ? `platform=${platform}` : tld ? `tld=${tld}` : '';
				if (!query) return;
				try {
					const res = await fetch(`/api/check?handle=${encodeURIComponent(handle)}&${query}`);
					const data = await res.json();
					if (id !== wave) return;
					const result = data.results?.[0];
					paint(card, result?.status ?? 'unknown', result?.url);
				} catch {
					if (id !== wave) return;
					paint(card, 'unknown');
				}
			}),
		);

		if (id === wave) tally();
	}

	function paint(card: Element, status: keyof typeof labels, url?: string) {
		card.setAttribute('data-status', status);
		const state = card.querySelector('.state');
		const link = card.querySelector('.link');
		if (state) state.textContent = labels[status] ?? 'Waiting';
		if (link instanceof HTMLAnchorElement) {
			const show = Boolean(url) && (status === 'taken' || status === 'unknown');
			link.hidden = !show;
			const domain = card.hasAttribute('data-tld');
			link.textContent = status === 'taken' ? (domain ? 'Open site' : 'View profile') : 'Open to confirm';
			if (url) link.href = url;
		}
	}

	function tally() {
		const counts = { available: 0, taken: 0, unknown: 0, invalid: 0 };
		for (const card of cards) {
			const status = card.getAttribute('data-status');
			if (status && status in counts) counts[status as keyof typeof counts] += 1;
		}
		const parts = [];
		if (counts.available) parts.push(`${counts.available} available`);
		if (counts.taken) parts.push(`${counts.taken} taken`);
		if (counts.unknown) parts.push(`${counts.unknown} unverified`);
		if (counts.invalid) parts.push(`${counts.invalid} invalid`);
		summary.textContent = parts.join(' · ');
		summary.hidden = parts.length === 0;
	}
</script>
