---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="page">
		<header class="top">
			<a class="brand" href="/">
				<span class="mark" aria-hidden="true"></span>
				FindHandle
			</a>
		</header>

		<main>
			<p class="kicker">Handle check</p>
			<h1>See if a name is free</h1>
			<p class="lede">Matching handles. A brand you can hold.</p>

			<form id="search" autocomplete="off" spellcheck="false">
				<label class="bar">
					<span class="at" aria-hidden="true">@</span>
					<input
						id="handle"
						name="handle"
						type="text"
						inputmode="text"
						autocapitalize="none"
						autocorrect="off"
						maxlength="30"
						placeholder="yourhandle"
						aria-label="Social handle"
					/>
					<button type="submit">Check</button>
				</label>
			</form>

			<div class="boards">
				<section class="board">
					<p class="row-label">Social</p>
					<div class="results" aria-live="polite">
						<article class="card" data-platform="youtube">
							<span class="logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20"><path fill="#FF0000" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
							</span>
							<h2>YouTube</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">View</a>
							<p class="state">Waiting</p>
						</article>

						<article class="card" data-platform="tiktok">
							<span class="logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20">
									<g transform="translate(12 12) scale(0.987654) translate(-11.995 -12)">
										<path fill="#25F4EE" transform="translate(-1.05 .15)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
										<path fill="#FE2C55" transform="translate(1.05 -.15)" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
										<path fill="#fff" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
									</g>
								</svg>
							</span>
							<h2>TikTok</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">View</a>
							<p class="state">Waiting</p>
						</article>

						<article class="card" data-platform="x">
							<span class="logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20"><g transform="translate(12 12) scale(1.112656) translate(-12.035 -12)"><path fill="#fff" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.425 6.231H2.72l7.662-8.57L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></g></svg>
							</span>
							<h2>X</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">View</a>
							<p class="state">Waiting</p>
						</article>

						<article class="card" data-platform="facebook">
							<span class="logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
							</span>
							<h2>Facebook</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">View</a>
							<p class="state">Waiting</p>
						</article>

						<article class="card" data-platform="instagram">
							<span class="logo" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="20" height="20">
									<defs>
										<radialGradient id="ig" cx="30%" cy="107%" r="150%">
											<stop offset="0%" stop-color="#fdf497"/>
											<stop offset="45%" stop-color="#fd5949"/>
											<stop offset="60%" stop-color="#d6249f"/>
											<stop offset="90%" stop-color="#285AEB"/>
										</radialGradient>
									</defs>
									<path fill="url(#ig)" d="M12 0C8.74 0 8.333.015 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.74 0 12s.015 3.667.072 4.947c.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.74 24 12 24s3.668-.015 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.69.073-4.948s-.014-3.667-.072-4.947c-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.26 0 12 0zm0 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.058 1.645-.07 4.849-.07zm0 3.675a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
								</svg>
							</span>
							<h2>Instagram</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">View</a>
							<p class="state">Waiting</p>
						</article>
					</div>
				</section>

				<section class="board">
					<p class="row-label">Domains</p>
					<div class="results" aria-live="polite">
						<article class="card" data-tld="com">
							<h2>.com</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
							<p class="state">Waiting</p>
						</article>
						<article class="card" data-tld="net">
							<h2>.net</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
							<p class="state">Waiting</p>
						</article>
						<article class="card" data-tld="org">
							<h2>.org</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
							<p class="state">Waiting</p>
						</article>
						<article class="card" data-tld="io">
							<h2>.io</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
							<p class="state">Waiting</p>
						</article>
						<article class="card" data-tld="ai">
							<h2>.ai</h2>
							<a class="link" hidden target="_blank" rel="noreferrer">Open</a>
							<p class="state">Waiting</p>
						</article>
					</div>
				</section>
			</div>

			<p id="summary" class="summary" hidden></p>
		</main>

		<footer>
			Public profile and RDAP lookup. Confirm before you claim a name.
			<p class="credit">
				<a href="https://bcqstudios.com" target="_blank" rel="noreferrer">Made with <span class="heart">&lt;3</span> by BCQStudios</a>
			</p>
		</footer>
	</div>
</Layout>

<style>
	.page {
		min-height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
	}

	.top {
		padding: 20px 24px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--fg);
		text-decoration: none;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.mark {
		width: 14px;
		height: 14px;
		border: 2px solid #fff;
		border-radius: 99px;
		box-shadow: 4px 4px 0 0 var(--available);
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: safe center;
		padding: 8px 16px 48px;
	}

	.kicker {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(28px, 5vw, 40px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		text-align: center;
	}

	.lede {
		margin: 10px 0 28px;
		color: var(--muted);
		font-size: 15px;
		text-align: center;
	}

	.row-label {
		margin: 0 0 4px;
		color: var(--muted);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	#search {
		width: min(560px, 100%);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 58px;
		padding: 6px 6px 6px 16px;
		background: var(--bar);
		color: var(--ink);
		border-radius: 10px;
	}

	.at {
		color: #6b6b73;
		font-size: 22px;
		font-weight: 700;
		line-height: 1;
	}

	#handle {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		background: transparent;
		color: var(--ink);
		font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", Consolas, monospace;
		font-size: 18px;
		letter-spacing: -0.02em;
		outline: none;
	}

	#handle::placeholder {
		color: #8b8b93;
	}

	.bar:focus-within {
		outline: 2px solid var(--fg);
		outline-offset: 3px;
	}

	button {
		height: 46px;
		min-width: 96px;
		padding: 0 18px;
		border: 0;
		border-radius: 8px;
		background: var(--ink);
		color: var(--bar);
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
	}

	button:hover {
		background: #1d1d22;
	}

	.boards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 28px 48px;
		width: min(680px, 100%);
		margin-top: 28px;
	}

	.results {
		display: flex;
		flex-direction: column;
	}

	.card {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 40px;
		padding: 8px 0;
		border-bottom: 1px solid var(--line);
	}

	.card:last-child {
		border-bottom: 0;
	}

	.logo {
		display: grid;
		place-items: center;
		flex: 0 0 20px;
		width: 20px;
		height: 20px;
		overflow: hidden;
	}

	.logo svg {
		display: block;
		width: 20px;
		height: 20px;
	}

	h2 {
		flex: 1;
		min-width: 0;
		margin: 0;
		font-size: 13px;
		font-weight: 600;
		line-height: 1;
	}

	[data-tld] h2 {
		font-family: ui-monospace, "Cascadia Code", "Segoe UI Mono", Consolas, monospace;
		font-size: 14px;
		letter-spacing: -0.02em;
	}

	.state {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		color: var(--muted);
	}

	.card[data-status='checking'] .state {
		animation: pulse 0.9s ease-in-out infinite;
	}

	.card[data-status='available'] .state {
		color: var(--available);
	}

	.card[data-status='taken'] .state {
		color: var(--taken);
	}

	.card[data-status='unknown'] .state,
	.card[data-status='invalid'] .state {
		color: var(--unknown);
	}

	.link {
		color: var(--muted);
		font-size: 11px;
		font-weight: 600;
		text-decoration: none;
	}

	.link:hover {
		color: var(--fg);
		text-decoration: underline;
	}

	.summary {
		margin: 18px 0 0;
		color: var(--muted);
		font-size: 13px;
	}

	footer {
		padding: 0 24px 24px;
		color: #6d6d75;
		font-size: 12px;
		text-align: center;
	}

	.credit {
		margin: 8px 0 0;
	}

	.credit a {
		color: inherit;
		text-decoration: none;
	}

	.credit a:hover {
		text-decoration: underline;
	}

	.heart {
		color: var(--taken);
	}

	@keyframes pulse {
		50% { opacity: 0.4; }
	}

	@media (max-width: 640px) {
		.boards {
			grid-template-columns: 1fr;
			gap: 22px;
		}
	}

	@media (max-width: 520px) {
		.top {
			padding: 16px;
		}

		.bar {
			height: 54px;
		}

		button {
			padding: 0 14px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card[data-status='checking'] .state {
			animation: none;
			opacity: 0.7;
		}
	}
</style>

<script>
	const labels = {
		idle: 'Waiting',
		checking: 'Checking',
		available: 'Available',
		taken: 'Taken',
		invalid: 'Invalid',
		unknown: 'Unverified',
	};

	const form = document.querySelector('#search') as HTMLFormElement;
	const input = document.querySelector('#handle') as HTMLInputElement;
	const summary = document.querySelector('#summary') as HTMLElement;
	const cards = document.querySelectorAll('.card');
	let timer = 0;
	let wave = 0;

	form.addEventListener('submit', (event) => {
		event.preventDefault();
		window.clearTimeout(timer);
		const handle = input.value.trim().replace(/^@+/, '').toLowerCase();
		if (handle) void run(handle);
		else reset();
	});

	input.addEventListener('input', () => {
		const next = input.value.replace(/^@+/, '').replace(/[^a-zA-Z0-9._-]/g, '');
		if (next !== input.value) input.value = next;
		window.clearTimeout(timer);
		const handle = next.trim().toLowerCase();
		if (!handle) {
			reset();
			return;
		}
		timer = window.setTimeout(() => {
			void run(handle);
		}, 400);
	});

	function reset() {
		wave += 1;
		for (const card of cards) paint(card, 'idle');
		summary.hidden = true;
		summary.textContent = '';
	}

	async function run(handle: string) {
		const id = ++wave;
		for (const card of cards) paint(card, 'checking');
		summary.hidden = true;

		await Promise.all([...cards].map(async (card) => {
			const platform = card.getAttribute('data-platform');
			const query = platform ? `platform=${platform}` : `tld=${card.getAttribute('data-tld')}`;
			try {
				const data = await (await fetch(`/api/check?handle=${encodeURIComponent(handle)}&${query}`)).json();
				if (id !== wave) return;
				paint(card, data.status ?? 'unknown', data.url);
			} catch {
				if (id !== wave) return;
				paint(card, 'unknown');
			}
		}));

		if (id !== wave) return;

		const counts = { available: 0, taken: 0, unknown: 0, invalid: 0 };
		for (const card of cards) {
			const status = card.getAttribute('data-status');
			if (status && status in counts) counts[status as keyof typeof counts] += 1;
		}
		const parts = [];
		if (counts.available) parts.push(`${counts.available} available`);
		if (counts.taken) parts.push(`${counts.taken} taken`);
		if (counts.unknown) parts.push(`${counts.unknown} unverified`);
		if (counts.invalid) parts.push(`${counts.invalid} invalid`);
		summary.textContent = parts.join(' · ');
		summary.hidden = parts.length === 0;
	}

	function paint(card: Element, status: keyof typeof labels, url?: string) {
		card.setAttribute('data-status', status);
		card.querySelector('.state')!.textContent = labels[status];
		const link = card.querySelector('.link') as HTMLAnchorElement;
		const show = Boolean(url) && (status === 'taken' || status === 'unknown');
		link.hidden = !show;
		if (!show) return;
		link.textContent = status === 'taken'
			? card.hasAttribute('data-tld') ? 'Open site' : 'View profile'
			: 'Open to confirm';
		link.href = url!;
	}
</script>
