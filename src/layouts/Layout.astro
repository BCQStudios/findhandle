<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Check if a name is free on YouTube, TikTok, X, Facebook, Instagram, and the top domains."
		/>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
		<title>FindHandle</title>
		<script is:inline>
			if (localStorage.theme === 'light') document.documentElement.dataset.theme = 'light';
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #161618;
		--fg: #f4f4f5;
		--muted: #9a9aa3;
		--line: #26262b;
		--bar: #ffffff;
		--ink: #0b0b0d;
		--taken: #ff2a2a;
		--available: #17d36a;
		--unknown: #d0d0d6;
	}

	html[data-theme='light'] {
		color-scheme: light;
		--bg: #eeeef0;
		--fg: #141416;
		--muted: #5c5c64;
		--line: #d2d2d8;
		--unknown: #3f3f46;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family: "Segoe UI", Inter, ui-sans-serif, system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.25s ease, color 0.25s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		body {
			transition: none;
		}
	}

	button,
	input {
		font: inherit;
	}

	.kicker {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(28px, 5vw, 40px);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}
</style>
