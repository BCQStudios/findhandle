<style is:global>
	:root {
		color-scheme: dark;
		--bg: #161618;
		--fg: #f4f4f5;
		--muted: #9a9aa3;
		--line: #26262b;
		--bar: #ffffff;
		--ink: #0b0b0d;
		--taken: #ff2a2a;
		--available: #17d36a;
		--unknown: #d0d0d6;
		--stroke: transparent;
	}

	html[data-theme='light'] {
		color-scheme: light;
		--bg: #eeeef0;
		--fg: #141416;
		--muted: #5c5c64;
		--line: #d2d2d8;
		--unknown: #3f3f46;
		--stroke: #d2d2d8;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		background: var(--bg);
		color: var(--fg);
		font-family: "Segoe UI", Inter, ui-sans-serif, system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.25s ease, color 0.25s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		body {
			transition: none;
		}
	}

	button,
	input {
		font: inherit;
	}
</style>
